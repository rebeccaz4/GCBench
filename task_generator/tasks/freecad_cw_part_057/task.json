{
  "id": "freecad_cw_part_057",
  "app": "freecad",
  "task": "Create a Part workbench box sized 38 mm along global X, 26 mm along global Y, and 18 mm along global Z, with its lower-back-left corner at the origin so it spans X = 0 to 38, Y = 0 to 26, and Z = 0 to 18. Remove the top face at Z = 18, then apply Part Thickness with wall thickness 2 mm inward to make an open-top rectangular shell. The shell should keep the outside dimensions 38 mm by 26 mm by 18 mm, have 2 mm thick walls and bottom, and have an interior cavity opening upward. Keep FreeCAD's default label 'Cube' for the Part box. Save the completed model to /home/user/Unnamed.FCStd.",
  "env": {
    "files": []
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Unnamed.FCStd",
      "key": "exists",
      "expected": true,
      "description": "Output model saved at /home/user/Unnamed.FCStd"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('required_type_contains') is True",
      "description": "CADWorld check: required_type_contains"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_0') is True",
      "description": "CADWorld check: object_0"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_1') is True",
      "description": "CADWorld check: object_1"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "key": "passed",
      "expected": true,
      "description": "CADWorld all-checks verdict (source benchmark's binary success)"
    }
  ]
}

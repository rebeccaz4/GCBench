{
  "id": "freecad_cw_part_025",
  "app": "freecad",
  "task": "Create one Part Design body. First create an additive box blank sized 52 mm along global X, 38 mm along global Y, and 12 mm along global Z, with its lower-back-left corner at the origin so the box spans X = 0 to 52, Y = 0 to 38, and Z = 0 to 12. Then create a subtractive torus centered at (26, 19, 12), with its ring lying in the XY plane and its axis along global Z. Set the torus major radius to 14 mm and minor radius to 3 mm, so the torus tube straddles the top face and cuts a centered circular groove whose deepest point is at Z = 9. Keep FreeCAD's default feature names 'Box' and 'Torus'. Save the completed model to /home/user/Unnamed.FCStd.",
  "env": {
    "files": []
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Unnamed.FCStd",
      "key": "exists",
      "expected": true,
      "description": "Output model saved at /home/user/Unnamed.FCStd"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('required_type_contains') is True",
      "description": "CADWorld check: required_type_contains"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_0') is True",
      "description": "CADWorld check: object_0"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_1') is True",
      "description": "CADWorld check: object_1"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_2') is True",
      "description": "CADWorld check: object_2"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "key": "passed",
      "expected": true,
      "description": "CADWorld all-checks verdict (source benchmark's binary success)"
    }
  ]
}

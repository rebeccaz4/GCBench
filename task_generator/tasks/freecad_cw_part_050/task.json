{
  "id": "freecad_cw_part_050",
  "app": "freecad",
  "task": "The precondition file is saved at /home/user/Precondition_Unnamed.FCStd. Open that file; it contains two separate horizontal line sketches on the XY plane. Sketch Line_A runs from (-20, 0, 0) to (20, 0, 0), and Sketch Line_B runs from (-20, 20, 0) to (20, 20, 0). Use the Part workbench to create a closed quadrilateral wire by adding the two side edges from (-20, 0, 0) to (-20, 20, 0) and from (20, 0, 0) to (20, 20, 0), then create one planar face from that closed wire. The finished model must contain: the two side edges as Part::Line objects (FreeCAD's default names Line and Line001); a Part Connect object (type Part::FeaturePython, label containing 'Connect') that joins the two sketches and the two lines; and a face object of type Part::Face whose source is that Connect object. Save the completed model to /home/user/Unnamed.FCStd.",
  "env": {
    "files": [
      {
        "filename": "Precondition_Unnamed.FCStd",
        "sandbox_path": "/home/user/Precondition_Unnamed.FCStd"
      }
    ]
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Unnamed.FCStd",
      "key": "exists",
      "expected": true,
      "description": "Output model saved at /home/user/Unnamed.FCStd"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('required_type_contains') is True",
      "description": "CADWorld check: required_type_contains"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_0') is True",
      "description": "CADWorld check: object_0"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_1') is True",
      "description": "CADWorld check: object_1"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_2') is True",
      "description": "CADWorld check: object_2"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_3') is True",
      "description": "CADWorld check: object_3"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_4') is True",
      "description": "CADWorld check: object_4"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_5') is True",
      "description": "CADWorld check: object_5"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "key": "passed",
      "expected": true,
      "description": "CADWorld all-checks verdict (source benchmark's binary success)"
    }
  ]
}

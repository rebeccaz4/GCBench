{
  "id": "renderdoc_sa_promote_archive",
  "app": "renderdoc",
  "task": "RenderDoc settings are stored in /home/user/.local/share/qrenderdoc/UI.config. In /home/user/captures, rename promoted.rdc to frame_latest.rdc and move the four old_*.rdc captures into a new folder /home/user/captures/old/. Update the recent capture list so that it points to the new locations: frame_latest.rdc first, then old_a, old_b, old_c and old_d (absolute paths), and set the last capture path to frame_latest.rdc. Keep rdocConfigData = 1.",
  "env": {
    "files": [
      {
        "filename": "UI.config",
        "sandbox_path": "/home/user/.local/share/qrenderdoc/UI.config"
      },
      {
        "filename": "promoted.rdc",
        "sandbox_path": "/home/user/captures/promoted.rdc"
      },
      {
        "filename": "old_a.rdc",
        "sandbox_path": "/home/user/captures/old_a.rdc"
      },
      {
        "filename": "old_b.rdc",
        "sandbox_path": "/home/user/captures/old_b.rdc"
      },
      {
        "filename": "old_c.rdc",
        "sandbox_path": "/home/user/captures/old_c.rdc"
      },
      {
        "filename": "old_d.rdc",
        "sandbox_path": "/home/user/captures/old_d.rdc"
      }
    ]
  },
  "verification": [
    {
      "command": "check-setting rdocConfigData 1",
      "key": "match",
      "expected": true,
      "description": "rdocConfigData kept"
    },
    {
      "command": "check-file-exists /home/user/captures/frame_latest.rdc",
      "key": "exists",
      "expected": true,
      "description": "exists: /home/user/captures/frame_latest.rdc"
    },
    {
      "command": "check-file-exists /home/user/captures/promoted.rdc",
      "key": "exists",
      "expected": false,
      "description": "removed: /home/user/captures/promoted.rdc"
    },
    {
      "command": "check-capture-count /home/user/captures/old 4",
      "key": "match",
      "expected": true,
      "description": "four old captures moved"
    },
    {
      "command": "check-capture-count /home/user/captures 1",
      "key": "match",
      "expected": true,
      "description": "only frame_latest.rdc at the top level"
    },
    {
      "command": "recent-captures",
      "eval": "result['files'] == ['/home/user/captures/frame_latest.rdc', '/home/user/captures/old/old_a.rdc', '/home/user/captures/old/old_b.rdc', '/home/user/captures/old/old_c.rdc', '/home/user/captures/old/old_d.rdc']",
      "description": "RecentCaptureFiles = frame_latest.rdc, old_a.rdc, old_b.rdc, old_c.rdc, old_d.rdc"
    },
    {
      "command": "check-setting LastCaptureFilePath /home/user/captures/frame_latest.rdc",
      "key": "match",
      "expected": true,
      "description": "LastCaptureFilePath = /home/user/captures/frame_latest.rdc"
    }
  ]
}

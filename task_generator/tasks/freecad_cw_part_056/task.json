{
  "id": "freecad_cw_part_056",
  "app": "freecad",
  "task": "Create a Part workbench box sized 36 mm along global X, 24 mm along global Y, and 12 mm along global Z, with its lower-back-left corner at the origin so it spans X = 0 to 36, Y = 0 to 24, and Z = 0 to 12. Apply a Part Offset Shape to the box with Offset = 2 mm outward, Mode = Skin, Join type = Tangent/Arc. Keep FreeCAD's default label 'Cube' for the Part box. Save the completed model to /home/user/Unnamed.FCStd.",
  "env": {
    "files": []
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Unnamed.FCStd",
      "key": "exists",
      "expected": true,
      "description": "Output model saved at /home/user/Unnamed.FCStd"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('required_type_contains') is True",
      "description": "CADWorld check: required_type_contains"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_0') is True",
      "description": "CADWorld check: object_0"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "eval": "result.get('checks', {}).get('object_1') is True",
      "description": "CADWorld check: object_1"
    },
    {
      "command": "cadworld-check /home/user/Unnamed.FCStd ",
      "key": "passed",
      "expected": true,
      "description": "CADWorld all-checks verdict (source benchmark's binary success)"
    }
  ]
}

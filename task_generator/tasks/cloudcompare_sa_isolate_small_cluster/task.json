{
  "id": "cloudcompare_sa_isolate_small_cluster",
  "app": "cloudcompare",
  "task": "Open /home/user/Documents/two_clusters.ply in CloudCompare. The cloud consists of two well-separated clusters of different sizes. Keep only the smaller cluster (discard every point of the other one), translate it so that the minimum corner of its bounding box lies exactly at the origin (0, 0, 0), compute per-point normals, and save it as a binary little-endian PLY at /home/user/Documents/small_cluster.ply.",
  "env": {
    "files": [
      {
        "filename": "two_clusters.ply",
        "sandbox_path": "/home/user/Documents/two_clusters.ply"
      }
    ]
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/Documents/small_cluster.ply",
      "key": "exists",
      "expected": true,
      "description": "output exists"
    },
    {
      "command": "check-point-count /home/user/Documents/small_cluster.ply 500",
      "key": "match",
      "expected": true,
      "description": "only the smaller cluster (500 points)"
    },
    {
      "command": "check-bbox-within /home/user/Documents/small_cluster.ply -0.02 -0.02 -0.02 5.61 6.36 5.99",
      "key": "match",
      "expected": true,
      "description": "translated so the bbox starts at the origin"
    },
    {
      "command": "check-bbox-min-extent /home/user/Documents/small_cluster.ply x 5.5",
      "key": "match",
      "expected": true,
      "description": "not scaled (x extent kept)"
    },
    {
      "command": "check-has-normals /home/user/Documents/small_cluster.ply",
      "key": "has_normals",
      "expected": true,
      "description": "normals computed"
    },
    {
      "command": "check-ply-format /home/user/Documents/small_cluster.ply binary_little_endian",
      "key": "match",
      "expected": true,
      "description": "binary little-endian PLY"
    }
  ]
}

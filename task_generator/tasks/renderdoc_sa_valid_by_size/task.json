{
  "id": "renderdoc_sa_valid_by_size",
  "app": "renderdoc",
  "task": "RenderDoc settings are stored in /home/user/.local/share/qrenderdoc/UI.config. Two of the five captures in /home/user/captures are corrupt: their files do not start with RenderDoc's 4-byte capture signature 'RDOC' (RenderDoc reports their file format as unrecognised). Delete those two. Set the recent capture list to the remaining captures (absolute paths) ordered from largest to smallest file. Also set Comments_ShowOnLoad = false, EventBrowser_AddFake = false, EventBrowser_ApplyColors = true and EventBrowser_Bookmarks = [5, 17, 42]. Keep rdocConfigData = 1.",
  "env": {
    "files": [
      {
        "filename": "UI.config",
        "sandbox_path": "/home/user/.local/share/qrenderdoc/UI.config"
      },
      {
        "filename": "frame_a.rdc",
        "sandbox_path": "/home/user/captures/frame_a.rdc"
      },
      {
        "filename": "frame_b.rdc",
        "sandbox_path": "/home/user/captures/frame_b.rdc"
      },
      {
        "filename": "frame_c.rdc",
        "sandbox_path": "/home/user/captures/frame_c.rdc"
      },
      {
        "filename": "frame_bad1.rdc",
        "sandbox_path": "/home/user/captures/frame_bad1.rdc"
      },
      {
        "filename": "frame_bad2.rdc",
        "sandbox_path": "/home/user/captures/frame_bad2.rdc"
      }
    ]
  },
  "verification": [
    {
      "command": "check-setting rdocConfigData 1",
      "key": "match",
      "expected": true,
      "description": "rdocConfigData kept"
    },
    {
      "command": "check-capture-count /home/user/captures 3",
      "key": "match",
      "expected": true,
      "description": "three captures left"
    },
    {
      "command": "check-file-exists /home/user/captures/frame_bad1.rdc",
      "key": "exists",
      "expected": false,
      "description": "removed: /home/user/captures/frame_bad1.rdc"
    },
    {
      "command": "check-file-exists /home/user/captures/frame_bad2.rdc",
      "key": "exists",
      "expected": false,
      "description": "removed: /home/user/captures/frame_bad2.rdc"
    },
    {
      "command": "recent-captures",
      "eval": "result['files'] == ['/home/user/captures/frame_b.rdc', '/home/user/captures/frame_a.rdc', '/home/user/captures/frame_c.rdc']",
      "description": "RecentCaptureFiles = frame_b.rdc, frame_a.rdc, frame_c.rdc"
    },
    {
      "command": "check-setting Comments_ShowOnLoad false",
      "key": "match",
      "expected": true,
      "description": "Comments_ShowOnLoad = false"
    },
    {
      "command": "check-setting EventBrowser_AddFake false",
      "key": "match",
      "expected": true,
      "description": "EventBrowser_AddFake = false"
    },
    {
      "command": "check-setting EventBrowser_ApplyColors true",
      "key": "match",
      "expected": true,
      "description": "EventBrowser_ApplyColors = true"
    },
    {
      "command": "check-setting EventBrowser_Bookmarks '[5,17,42]'",
      "key": "match",
      "expected": true,
      "description": "EventBrowser_Bookmarks = [5,17,42]"
    }
  ]
}

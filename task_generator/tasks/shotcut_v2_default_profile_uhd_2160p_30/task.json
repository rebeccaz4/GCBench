{
  "id": "shotcut_v2_default_profile_uhd_2160p_30",
  "app": "shotcut",
  "task": "Shotcut is open with a placeholder project /home/user/Documents/prefs_uhd.mlt. Your task is to set Shotcut's default Video Mode to 'UHD 2160p 30 fps'.\n\nShotcut should persist this setting.",
  "env": {
    "files": [
      {
        "filename": "prefs_uhd.mlt",
        "sandbox_path": "/home/user/Documents/prefs_uhd.mlt"
      }
    ]
  },
  "verification": [
    {
      "command": "check-file-exists /home/user/.config/Meltytech/Shotcut.conf",
      "key": "exists",
      "expected": true,
      "description": "Shotcut configuration file exists"
    },
    {
      "command": "check-config-value player profile uhd_2160p_30",
      "key": "match",
      "expected": true,
      "description": "player.profile equals 'uhd_2160p_30'"
    }
  ]
}

# Set only the credentials required by the chosen model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=

# Optional OpenAI-compatible endpoint for hosted or local GUI models.
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1

# Judge configuration for task checks explicitly marked judge=llm.
# JUDGE_API_KEY=
# JUDGE_BASE_URL=https://api.openai.com/v1
# JUDGE_MODEL=gpt-5.4

ENV_BACKEND=docker
DOCKER_ENV_IMAGE=gcbench-desktop:latest
DOCKER_ENV_PLATFORM=linux/amd64
EVAL_MAX_ITERATIONS=40
EVAL_SANDBOX_TIMEOUT=3600

# For Apptainer, specify an image built from the same desktop environment.
# APPTAINER_ENV_IMAGE=/absolute/path/to/gcbench-desktop.sif
